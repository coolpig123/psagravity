# Optional. Copy to .env only to override the defaults. Never commit .env.
# Earth Engine Cloud project; empty = the team project (geelayers.auth.DEFAULT_PROJECT)
EE_PROJECT=
# Optional, for servers: path to a service-account JSON key (leave empty to log in with your Google account)
EE_SERVICE_ACCOUNT_KEY=

# Meteomatics Weather API credentials (defaults to the team hackathon account in meteomatics.py)
METEOMATICS_USERNAME=***REMOVED***
METEOMATICS_PASSWORD=***REMOVED***
